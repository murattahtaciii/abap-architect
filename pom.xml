<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.murattahtaciii.abaparchitect</groupId>
  <artifactId>io.github.murattahtaciii.abaparchitect.parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>ABAP Architect</name>
  <description>JSON/XML verisinden ABAP tip tanımları, iXML, Simple Transformation ve şablon kodu üreten Eclipse eklentisi.</description>

  <modules>
    <module>plugins/io.github.murattahtaciii.abaparchitect</module>
    <module>features/io.github.murattahtaciii.abaparchitect.feature</module>
    <module>releng/io.github.murattahtaciii.abaparchitect.site</module>
  </modules>

  <properties>
    <tycho.version>5.0.4</tycho.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <eclipse.release>2026-03</eclipse.release>
    <target.file>${maven.multiModuleProjectDirectory}/releng/target/io.github.murattahtaciii.abaparchitect.target.target</target.file>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <target>
            <file>${target.file}</file>
          </target>
          <executionEnvironment>JavaSE-21</executionEnvironment>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>local-target</id>
      <properties>
        <target.file>${maven.multiModuleProjectDirectory}/releng/target/io.github.murattahtaciii.abaparchitect.target.local.target</target.file>
      </properties>
    </profile>
  </profiles>

</project>
